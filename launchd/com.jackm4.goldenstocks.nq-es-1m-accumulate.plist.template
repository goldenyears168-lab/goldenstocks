<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.nq-es-1m-accumulate</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{NQ_ES_1M_ACCUMULATE_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PYTHONPATH</key>
		<string>{{PROJECT_ROOT}}/src</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key><integer>8</integer>
			<key>Minute</key><integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key><integer>20</integer>
			<key>Minute</key><integer>0</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/nq-es-1m-accumulate.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/nq-es-1m-accumulate.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
