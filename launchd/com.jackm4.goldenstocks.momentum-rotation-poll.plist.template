<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.momentum-rotation-poll</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{MOMENTUM_ROTATION_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GOLDENSTOCKS_DATA_DIR</key>
		<string>/Users/jackm4/goldenstocks-data</string>
		<key>TZ</key>
		<string>Asia/Taipei</string>
		<!-- dry-run-first 預設（比照 leading-dip/songshan/expert-pool/detach-gate），
		     不是 dayflip-futures-short 那種例外。要送真單需使用者另外明確把這個
		     旗標改成 1（且 .env 的 ORDER_MASTER_ENABLED 也要開）。 -->
		<key>ORDER_MOMENTUM_ROTATION_AUTO_SUBMIT</key>
		<string>0</string>
		<key>ORDER_MOMENTUM_ROTATION_WORKER_INTERVAL</key>
		<string>20</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/momentum-rotation-poll.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/momentum-rotation-poll.launchd.err.log</string>
</dict>
</plist>
