<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jackm4.goldenstocks.futopt-mis-depth-collect</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>{{FUTOPT_MIS_DEPTH_LAUNCHER}}</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>44</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/futopt-mis-depth.out.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/futopt-mis-depth.err.log</string>
  <key>EnvironmentVariables</key><dict><key>TZ</key><string>Asia/Taipei</string></dict>
</dict>
</plist>
