<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.limitup-books-collect</string>
	<!-- 現股漲停候選五檔收集器 · 走 TWSE MIS 公開 API，**不佔富邦 ws 連線額度**
	     （mini 已有 5 條，第 6 條撞過 Maximum number of connections reached）。
	     唯讀、無送單路徑。研究層 job，刻意不在 scripts/install-launchd.sh 的
	     LABELS 陣列裡（比照 futopt-books-collect-stocks / pivot-wall-daily），
	     安裝方式見 .command 檔頭。 -->
	<key>ProgramArguments</key>
	<array>
		<string>{{LIMITUP_BOOKS_COLLECT_LAUNCHER}}</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/limitup-books-collect.out.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/limitup-books-collect.err.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
