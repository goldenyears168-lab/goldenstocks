<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.etf-holdings-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ETF_HOLDINGS_SYNC_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PYTHONPATH</key>
		<string>{{PROJECT_ROOT}}/src</string>
	</dict>
	<!-- 每天 18:00（不給 Weekday = 週一至日） -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key><integer>18</integer>
		<key>Minute</key><integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/etf-holdings-sync.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/etf-holdings-sync.launchd.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
