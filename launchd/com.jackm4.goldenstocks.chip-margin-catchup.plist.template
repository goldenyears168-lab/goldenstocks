<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.chip-margin-catchup</string>
	<!-- 週一至五 21:10 · 融資/借券/當沖補追同步（唯讀 FinMind API，寫 stock_margin_daily
	     等籌碼表）。主線 daily-sync（16:35）比 TWSE 當日融資餘額發布時間早，補這一趟。
	     刻意不進 install-launchd.sh 的 LABELS（比照 vixtwn-daily-sync），安裝方式見
	     scripts/launchd/chip-margin-catchup.command 檔頭。 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{CHIP_MARGIN_CATCHUP_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
	</array>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/chip-margin-catchup.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/chip-margin-catchup.launchd.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
